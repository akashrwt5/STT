{
  "_meta": { "language": "fr", "status": "draft-for-native-review" },
  "grammar": {
    "time_format": "24h",
    "decimal_hour_idioms": [
      { "phrase": "et quart", "minutes": 15 },
      { "phrase": "et demie", "minutes": 30 },
      { "phrase": "et demi", "minutes": 30 },
      { "phrase": "moins le quart", "minutes": -15 },
      { "phrase": "moins quart", "minutes": -15 },
      { "phrase": "midi", "hour": 12, "minutes": 0 },
      { "phrase": "minuit", "hour": 0, "minutes": 0 },
      { "phrase": "midi et demi", "hour": 12, "minutes": 30 },
      { "phrase": "minuit et demi", "hour": 0, "minutes": 30 }
    ],
    "conjunction": "et",
    "notes": "Default 24h clock. Hour+minute juxtaposed with 'h': '15h30', '9h'. 'moins le quart' subtracts 15 min from NEXT hour. 'midi'=12:00, 'minuit'=00:00."
  },
  "weekdays": {
    "Monday": ["lundi","lun"],
    "Tuesday": ["mardi","mar"],
    "Wednesday": ["mercredi","mer"],
    "Thursday": ["jeudi","jeu"],
    "Friday": ["vendredi","ven"],
    "Saturday": ["samedi","sam"],
    "Sunday": ["dimanche","dim"]
  },
  "day_anchors": {
    "today": ["aujourd'hui","aujourdhui","ce jour"],
    "tomorrow": ["demain"],
    "day_after_tomorrow": ["après-demain","apres-demain","le surlendemain"],
    "yesterday": ["hier"],
    "next_week": ["la semaine prochaine","semaine prochaine","la prochaine semaine"],
    "next_month": ["le mois prochain","mois prochain"],
    "next_year": ["l'année prochaine","l'an prochain","année prochaine"],
    "this_weekend": ["ce week-end","ce weekend","ce week end","le week-end","ce samedi-dimanche"]
  },
  "months": {
    "January": ["janvier","janv"],
    "February": ["février","fevrier","févr","fev"],
    "March": ["mars"],
    "April": ["avril","avr"],
    "May": ["mai"],
    "June": ["juin"],
    "July": ["juillet","juil"],
    "August": ["août","aout"],
    "September": ["septembre","sept"],
    "October": ["octobre","oct"],
    "November": ["novembre","nov"],
    "December": ["décembre","decembre","déc","dec"]
  },
  "time_of_day": {
    "morning": { "names": ["matin","le matin","ce matin","dans la matinée","du matin"], "hour": 8 },
    "noon": { "names": ["midi","à midi","le midi"], "hour": 12 },
    "afternoon": { "names": ["après-midi","apres-midi","cet après-midi","dans l'après-midi","de l'après-midi"], "hour": 14 },
    "evening": { "names": ["soir","le soir","ce soir","dans la soirée","du soir"], "hour": 18 },
    "night": { "names": ["nuit","la nuit","cette nuit","tard"], "hour": 21 },
    "midnight": { "names": ["minuit","à minuit"], "hour": 0 }
  },
  "numbers_0_to_31": {
    "0": ["zéro","zero"], "1": ["un","une"], "2": ["deux"], "3": ["trois"],
    "4": ["quatre"], "5": ["cinq"], "6": ["six"], "7": ["sept"], "8": ["huit"],
    "9": ["neuf"], "10": ["dix"], "11": ["onze"], "12": ["douze"],
    "13": ["treize"], "14": ["quatorze"], "15": ["quinze"], "16": ["seize"],
    "17": ["dix-sept","dix sept"], "18": ["dix-huit","dix huit"],
    "19": ["dix-neuf","dix neuf"], "20": ["vingt"],
    "21": ["vingt et un","vingt-et-un"], "22": ["vingt-deux","vingt deux"],
    "23": ["vingt-trois","vingt trois"], "24": ["vingt-quatre","vingt quatre"],
    "25": ["vingt-cinq","vingt cinq"], "26": ["vingt-six","vingt six"],
    "27": ["vingt-sept","vingt sept"], "28": ["vingt-huit","vingt huit"],
    "29": ["vingt-neuf","vingt neuf"], "30": ["trente"],
    "31": ["trente et un","trente-et-un"]
  },
  "relative_units": {
    "minute": ["minute","minutes","min","mn"],
    "hour": ["heure","heures","h"],
    "day": ["jour","jours","journée","journées"],
    "week": ["semaine","semaines"],
    "month": ["mois"],
    "year": ["an","ans","année","années"]
  },
  "relative_markers": {
    "in": ["dans","d'ici","après","au bout de"],
    "at": ["à","a","vers","aux alentours de"],
    "on": ["le","ce","cette","les"]
  },
  "affirmative": ["yes","ok","okay","oui","ouais","ouaip","d'accord","bien sûr","envoie","envoie-le","confirme","c'est correct","c'est bon","exact","vas-y","fais-le","s'il te plaît"],
  "negative": ["no","non","nan","annule","annuler","arrête","arrêter","stop","ne fais pas","non merci","laisse tomber","oublie"],
  "uncertain": ["je ne sais pas","je sais pas","j'sais pas","chais pas","peut-être","peut etre","pas sûr","pas certain","je ne suis pas sûr","laisse-moi réfléchir","attends","hmm","euh"],
  "carrier_phrases": [
    "^rappelle[\\s-]moi\\s+(de\\s+|d')?\\s*",
    "^rappelle\\s+moi\\s+(de\\s+|d')?\\s*",
    "^n'oublie\\s+pas\\s+(de\\s+|d')?\\s*",
    "^noublie\\s+pas\\s+(de\\s+|d')?\\s*",
    "^fais[\\s-]moi\\s+penser\\s+(?:à|a|de|d')?\\s*",
    "^mets[\\s-]moi\\s+un\\s+rappel\\s+(?:pour|de|d')?\\s*",
    "^mets\\s+un\\s+rappel\\s+(?:pour|de|d')?\\s*",
    "^pense\\s+à\\s+me\\s+rappeler\\s+(?:de\\s+|d')?\\s*",
    "\\s+(?:s'il\\s+te\\s+plaît|s'il\\s+te\\s+plait|stp|svp)\\s*$"
  ]
}
