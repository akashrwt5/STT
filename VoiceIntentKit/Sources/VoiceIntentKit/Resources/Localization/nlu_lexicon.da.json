{
  "_meta": { "language": "da", "status": "draft-for-native-review" },
  "grammar": {
    "time_format": "24h",
    "decimal_hour_idioms": [
      {"phrase": "kvart over", "minutes": 15},
      {"phrase": "halv", "minutes": -30},
      {"phrase": "kvart i", "minutes": -15}
    ],
    "conjunction": "og",
    "notes": "PARSER TRAP: Danish 'halv' counts DOWN to the named hour. 'halv tre' = 2:30, NOT 3:30. 'kvart over to' = 2:15, 'kvart i tre' = 2:45. 'klokken' (often 'kl.') precedes a bare hour number."
  },
  "weekdays": {
    "Monday": ["mandag","man"],
    "Tuesday": ["tirsdag","tir","tirs"],
    "Wednesday": ["onsdag","ons"],
    "Thursday": ["torsdag","tor","tors"],
    "Friday": ["fredag","fre"],
    "Saturday": ["lørdag","lør"],
    "Sunday": ["søndag","søn"]
  },
  "day_anchors": {
    "today": ["i dag","idag"],
    "tomorrow": ["i morgen","imorgen"],
    "day_after_tomorrow": ["i overmorgen","overmorgen"],
    "yesterday": ["i går","igår"],
    "next_week": ["næste uge","i næste uge"],
    "next_month": ["næste måned","i næste måned"],
    "next_year": ["næste år","til næste år"],
    "this_weekend": ["i weekenden","denne weekend","til weekend"]
  },
  "months": {
    "January": ["januar","jan"],
    "February": ["februar","feb"],
    "March": ["marts","mar"],
    "April": ["april","apr"],
    "May": ["maj"],
    "June": ["juni","jun"],
    "July": ["juli","jul"],
    "August": ["august","aug"],
    "September": ["september","sep","sept"],
    "October": ["oktober","okt"],
    "November": ["november","nov"],
    "December": ["december","dec"]
  },
  "time_of_day": {
    "morning": {"names": ["morgen","om morgenen","formiddag","om formiddagen"], "hour": 8},
    "noon": {"names": ["middag","ved middagstid","klokken tolv"], "hour": 12},
    "afternoon": {"names": ["eftermiddag","om eftermiddagen"], "hour": 14},
    "evening": {"names": ["aften","om aftenen"], "hour": 18},
    "night": {"names": ["nat","om natten","i nat"], "hour": 21},
    "midnight": {"names": ["midnat","ved midnat"], "hour": 0}
  },
  "numbers_0_to_31": {
    "0": ["nul"], "1": ["en","et","én"], "2": ["to"], "3": ["tre"],
    "4": ["fire"], "5": ["fem"], "6": ["seks"], "7": ["syv"], "8": ["otte"],
    "9": ["ni"], "10": ["ti"], "11": ["elleve"], "12": ["tolv"],
    "13": ["tretten"], "14": ["fjorten"], "15": ["femten"], "16": ["seksten"],
    "17": ["sytten"], "18": ["atten"], "19": ["nitten"], "20": ["tyve"],
    "21": ["enogtyve"], "22": ["toogtyve"], "23": ["treogtyve"],
    "24": ["fireogtyve"], "25": ["femogtyve"], "26": ["seksogtyve"],
    "27": ["syvogtyve"], "28": ["otteogtyve"], "29": ["niogtyve"],
    "30": ["tredive"], "31": ["enogtredive"]
  },
  "relative_units": {
    "minute": ["minut","minutter","min"],
    "hour": ["time","timer"],
    "day": ["dag","dage"],
    "week": ["uge","uger"],
    "month": ["måned","måneder"],
    "year": ["år"]
  },
  "relative_markers": {
    "in": ["om","efter","inden for","indenfor"],
    "at": ["klokken","kl","kl."],
    "on": ["på","om","den"]
  },
  "affirmative": ["yes","ok","okay","ja","jo","jep","jovist","ja tak","klart","selvfølgelig","send","send den","bekæft","korrekt","rigtigt","gør det","kør","værsgo"],
  "negative": ["no","cancel","stop","nej","næ","nej tak","annuller","lad være","stop det","glem det","ikke noget","negativ"],
  "uncertain": ["det ved jeg ikke","ved ikke","måske","muligvis","jeg er ikke sikker","ikke sikker","lad mig tænke","lad mig lige tænke","hmm","øh"],
  "carrier_phrases": [
    "^mind\\s+mig\\s+om\\s+(?:at\\s+)?",
    "^husk\\s+(?:at\\s+)?",
    "^husk\\s+mig\\s+(?:på|om)\\s+(?:at\\s+)?",
    "^glem\\s+ikke\\s+(?:at\\s+)?",
    "^jeg\\s+skal\\s+huske\\s+(?:at\\s+)?",
    "^kan\\s+du\\s+minde\\s+mig\\s+om\\s+(?:at\\s+)?",
    "\\s+(?:tak|venligst)\\s*$"
  ]
}
