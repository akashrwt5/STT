# macOS
.DS_Store

# Xcode — per-developer state, never shared
xcuserdata/
*.xcuserstate
*.xcscmblueprint
*.xccheckout

# Xcode build products
build/
DerivedData/

# Swift Package Manager
.build/
.swiftpm/xcode/package.xcworkspace/
Package.resolved

# Packs unpacked at runtime (the app writes these to Application Support;
# nothing here should ever be committed). The SEED pack under
# Sources/VoiceAISeedPackEN/ IS committed — it ships in the app.
/UnpackedPacks/

# Xcode regenerates the aggregate <Package>-Package scheme on demand. VoiceAIKit's
# own scheme already runs the tests, through .swiftpm/VoiceAIKit.xctestplan, so the
# aggregate is a second name for the same thing — and the one that drifted after the
# rename while nobody was looking at it.
VoiceAIKit/.swiftpm/xcode/xcshareddata/xcschemes/*-Package.xcscheme
